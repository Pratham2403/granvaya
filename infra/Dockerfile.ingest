# Build stub for services/ingest (Python). Isolated from the Node deployables
# per ADR-6 — a failure here must never affect apps/web (NFR-10).
FROM python:3.12-slim AS base
WORKDIR /app

COPY services/ingest/pyproject.toml ./
COPY services/ingest/src ./src
RUN pip install --no-cache-dir -e .

CMD ["python", "-m", "ingest.main"]
