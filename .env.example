# PostgreSQL — must have Apache AGE and pgvector extensions available (see docs/SRS.md Open Question #1)
DATABASE_URL=postgres://user:password@localhost:5432/granvaya

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# LLM providers — routed per call via packages/llm, keys added as providers are wired
LLM_PROVIDER_DEFAULT=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Product analytics
POSTHOG_KEY=
POSTHOG_HOST=https://app.posthog.com

# Job queue (pg-boss uses DATABASE_URL directly — no separate broker)
